# Copy to .env (git ignored) and personalise the host ports the development
# stack publishes. Docker Compose reads .env automatically; every variable
# falls back to the default shown here when unset.

# Vite dev server (node)
NODE_PORT=3000

# nginx: the compiled frontend and the API
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# PostgreSQL
POSTGRES_PORT=5432
